{
  "name": "@diana/simulators",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de módulos y dianas Diana (WP-05). Sustituto contractual del firmware ESP32 para partidas completas y E2E sin hardware.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "diana-sim": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "mqtt": "^5.10.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
