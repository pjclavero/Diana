# ============================================================================
# Diana · variables de entorno (EJEMPLO)
# ============================================================================
# Copia este fichero a `.env` y sustituye TODOS los valores de ejemplo.
# `.env` está en .gitignore: nunca se sube a git. Este fichero SÍ se sube y
# NO debe contener secretos reales, sólo valores de ejemplo evidentes.
#
# Cómo generar secretos fuertes:
#   openssl rand -base64 32          # para contraseñas / secretos genéricos
#   openssl rand -hex 32             # para claves en formato hex
#   pwgen -s 24 1                    # alternativa si tienes pwgen instalado
#
# Las contraseñas de los módulos MQTT NO se ponen aquí: se generan con
# infrastructure/mosquitto/generate-users.sh y se guardan en
# infrastructure/mosquitto/passwd (fichero binario de mosquitto_passwd,
# ignorado por git).
# ============================================================================

# ----------------------------------------------------------------------------
# General
# ----------------------------------------------------------------------------
# Entorno: production | development | test
NODE_ENV=production
# Nombre/identificador de la instalación (usado en logs y en el system_id por defecto)
DIANA_INSTALLATION_NAME=diana-lab
# Zona horaria del servidor (toda la pila corre en UTC; esto sólo afecta a logs locales)
TZ=UTC

# ----------------------------------------------------------------------------
# Dominio / proxy
# ----------------------------------------------------------------------------
# Nombre de host público (o local) que sirve el proxy nginx
DIANA_PUBLIC_HOSTNAME=diana.example.local
# Puerto HTTP expuesto en el host por el proxy
PROXY_HTTP_PORT=8080
# Puerto HTTPS expuesto en el host por el proxy (requiere certificados, ver infrastructure/proxy/README)
PROXY_HTTPS_PORT=8443

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_DB=diana
POSTGRES_USER=diana_app
# EJEMPLO — genera uno real con: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
# Host/puerto internos (red docker interna; no se exponen al host en producción)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Cadena de conexión completa que usan backend/worker/migrate (Prisma)
DATABASE_URL=postgresql://diana_app:CHANGE_ME_use_openssl_rand_base64_32@postgres:5432/diana?schema=public
# Puerto publicado en el host SOLO en compose.dev.yml (para depurar con un cliente SQL local)
POSTGRES_DEV_HOST_PORT=5433

# ----------------------------------------------------------------------------
# Mosquitto (MQTT)
# ----------------------------------------------------------------------------
MQTT_HOST=mosquitto
# Puerto TLS del broker: es el único que se publica al host (P0-2). El backend
# construye su URL como ${MQTT_PROTOCOL}://${MQTT_HOST}:${MQTT_PORT}, con
# `mqtts` y 8883 por defecto; compose pasa MQTT_TLS_PORT a ambos.
MQTT_TLS_PORT=8883
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
# PEM de la CA propia con la que el backend valida al broker. Se genera con
# infrastructure/mosquitto/generate-certs.sh y se monta SÓLO el certificado
# público: ca.key no entra en ningún contenedor.
MQTT_CA_FILE=/app/certs/mqtt-ca.crt
MQTT_WS_PORT=9001
# Usuario y contraseña del BACKEND en mosquitto (único cliente con permiso sobre
# system/# y config/desired; ver infrastructure/mosquitto/acl). Generar con:
#   infrastructure/mosquitto/generate-users.sh backend
MQTT_BACKEND_USERNAME=backend
# EJEMPLO — no reutilizar, generar con mosquitto_passwd
MQTT_BACKEND_PASSWORD=CHANGE_ME_use_generate-users.sh
# Usuario de sólo prueba de conectividad para el healthcheck del contenedor
# mosquitto (sin permisos sobre targets/v1/#, ver infrastructure/mosquitto/acl).
# Generar con: infrastructure/mosquitto/generate-users.sh healthcheck
MQTT_HEALTHCHECK_USERNAME=healthcheck
MQTT_HEALTHCHECK_PASSWORD=CHANGE_ME_use_generate-users.sh

# ----------------------------------------------------------------------------
# Backend (NestJS)
# ----------------------------------------------------------------------------
BACKEND_PORT=3000
# Secreto de firma JWT del panel. El backend lo lee como JWT_SECRET y ABORTA el
# arranque en producción si falta (configuration.ts). Compose lo mapea:
# JWT_SECRET=${BACKEND_JWT_SECRET}. EJEMPLO INSEGURO — genera uno real con:
#   openssl rand -base64 32
BACKEND_JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32_INSEGURO
# Orígenes CORS permitidos (separados por coma). El backend lo lee como
# CORS_ORIGINS (plural); compose lo mapea CORS_ORIGINS=${BACKEND_CORS_ORIGIN}.
# En producción, restringir al origen real que sirve nginx (p.ej.
# http://192.168.1.209:8080).
BACKEND_CORS_ORIGIN=http://localhost:8080
# Nivel de log: error | warn | info | debug
BACKEND_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Worker
# ----------------------------------------------------------------------------
WORKER_LOG_LEVEL=info
# Cron de tareas diferidas (informes, limpieza), formato estándar de 5 campos
WORKER_REPORTS_CRON=0 3 * * *

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
FRONTEND_PORT=8081
# URL base de la API que consume el frontend (a través del proxy)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws

# ----------------------------------------------------------------------------
# Backups
# ----------------------------------------------------------------------------
# Retención en número de copias por franja
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
# Hora de ejecución del backup diario dentro del contenedor `backup` (cron, 5 campos)
BACKUP_CRON=30 2 * * *

# ----------------------------------------------------------------------------
# Simulador de módulos (perfil `simulator`)
# ----------------------------------------------------------------------------
# Número de módulos simulados (1-9) y semilla determinista para escenarios E2E
SIMULATOR_MODULE_COUNT=3
SIMULATOR_SEED=42
# Prefijo de module_id que usará el simulador, debe casar con infrastructure/mosquitto/acl
SIMULATOR_MODULE_PREFIX=sim

# ----------------------------------------------------------------------------
# Monitorización (perfil `monitoring`, opcional)
# ----------------------------------------------------------------------------
MONITORING_HTTP_PORT=9090
