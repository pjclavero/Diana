{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diana.seccionnueve/contracts/mqtt/ota-command.schema.json",
  "title": "Orden OTA",
  "description": "targets/v1/module/{module_id}/ota · QoS 1 · retain=false. El módulo rechaza la orden si hay una partida activa (dosier 13.6).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "command_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_in_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "nonce": {
      "type": "integer",
      "minimum": 0
    },
    "issuer": {
      "type": "string",
      "enum": [
        "backend",
        "coordinator",
        "operator-cli"
      ]
    },
    "module_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "action": {
      "type": "string",
      "enum": [
        "update",
        "confirm",
        "rollback",
        "cancel"
      ]
    },
    "firmware": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL HTTP(S) servida por el backend en la red local."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "signature": {
          "type": "string",
          "description": "Firma del binario en base64. Verificada por el bootloader antes de activar."
        },
        "target_board": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "version",
        "url",
        "size_bytes",
        "sha256",
        "signature",
        "target_board"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "issued_at_ms",
    "expires_in_ms",
    "nonce",
    "issuer",
    "module_id",
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "update"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "firmware"
        ]
      }
    }
  ]
}
