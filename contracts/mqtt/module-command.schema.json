{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diana.seccionnueve/contracts/mqtt/module-command.schema.json",
  "title": "Comando a módulo",
  "description": "targets/v1/module/{module_id}/command · QoS 1 · retain=false. Caduca según expires_in_ms.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "../schemas/common.schema.json#/$defs/schemaVersion"
    },
    "command_id": {
      "$ref": "../schemas/common.schema.json#/$defs/uuid"
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_in_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000,
      "description": "Vida del comando en milisegundos, medida desde issued_at_ms del emisor y NO desde la recepción: si se midiera desde la recepción, el temporizador se reiniciaría en cada reentrega de QoS 1 y no protegería contra reproducción (dosier 23.3). El receptor descarta el comando si (ahora - issued_at_ms) > expires_in_ms."
    },
    "nonce": {
      "type": "integer",
      "minimum": 0,
      "description": "Contador monotónico por emisor. El receptor lo PERSISTE en NVS, igual que local_sequence, y rechaza todo nonce menor o igual al último aceptado. Sin persistencia, un reinicio reabriría la ventana de reproducción."
    },
    "issuer": {
      "type": "string",
      "enum": [
        "backend",
        "coordinator",
        "operator-cli"
      ]
    },
    "module_id": {
      "$ref": "../schemas/common.schema.json#/$defs/identifier"
    },
    "action": {
      "type": "string",
      "enum": [
        "identify",
        "set_targets",
        "set_all_targets",
        "reboot",
        "start_calibration",
        "abort_calibration",
        "self_test",
        "led_test",
        "flush_queue",
        "set_maintenance",
        "clear_error"
      ]
    },
    "params": {
      "type": "object",
      "description": "Parámetros dependientes de 'action'. Validados por el firmware según la acción.",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "state": {
          "$ref": "../schemas/common.schema.json#/$defs/targetState"
        },
        "targets": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "target_index": {
                "$ref": "../schemas/common.schema.json#/$defs/targetIndex"
              },
              "state": {
                "$ref": "../schemas/common.schema.json#/$defs/targetState"
              }
            },
            "required": [
              "target_index",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "game_id": {
          "oneOf": [
            {
              "$ref": "../schemas/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "round_id": {
          "oneOf": [
            {
              "$ref": "../schemas/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "issued_at_ms",
    "expires_in_ms",
    "nonce",
    "issuer",
    "module_id",
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_targets"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "required": [
              "targets"
            ],
            "properties": {
              "targets": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_all_targets"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "required": [
              "state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "identify"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "required": [
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_maintenance"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "required": [
              "enabled"
            ]
          }
        }
      }
    }
  ]
}
