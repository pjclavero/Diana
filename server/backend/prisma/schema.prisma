// Esquema de datos de Diana.
//
// Normativo:
//   - ADR-0002 (modelo temporal de cuatro marcas): en `hit_events` conviven
//     T1 (device_*), T2 (coordinator_*), T3 (received_at) y T4 (persisted_at).
//     El backend NUNCA reescribe T1 ni T2; sólo puede MARCAR el evento con
//     `out_of_window` + `out_of_window_reason`.
//   - ADR-0003 (idempotencia): índice único sobre `event_id` y restricción
//     única sobre (module_id, boot_id, local_sequence).
//   - ADR-0006 (precisión no calculable): munición inicial, restante, disparos,
//     impactos detectados/válidos/incorrectos se almacenan por separado y los
//     derivados son anulables.
//   - Dosier 21.1 (23 entidades) y 21.2 (principios).
//
// Unidades: todos los tiempos de impacto y de juego se guardan en MICROSEGUNDOS
// (BigInt). Las marcas de servidor son `timestamptz` (DateTime, UTC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. Identidad, permisos y personas
// ---------------------------------------------------------------------------

/// Roles del dosier 23.2. `permissions` es la lista de permisos finos.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(32)
  description String?  @db.VarChar(255)
  permissions String[]
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(64)
  email              String?   @unique @db.VarChar(255)
  displayName        String?   @map("display_name") @db.VarChar(128)
  /// Hash bcrypt. Nunca se almacena ni se registra la contraseña en claro.
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  /// Obliga a cambiar la credencial generada en el primer arranque.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  active             Boolean   @default(true)
  roleId             String    @map("role_id") @db.Uuid
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role         Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  players      Player[]
  auditLogs    AuditLog[]
  ownedModules Module[]       @relation("ModuleOwner")
  ownedPresets GamePreset[]   @relation("PresetOwner")
  ownedViews   View[]         @relation("ViewOwner")
  ownedLayouts MatrixLayout[] @relation("LayoutOwner")

  @@index([roleId])
  @@index([active])
  @@map("users")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(128)
  description String?  @db.VarChar(512)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  players      Player[]
  participants Participant[]

  @@map("teams")
}

model Player {
  id          String    @id @default(uuid()) @db.Uuid
  displayName String    @map("display_name") @db.VarChar(128)
  firstName   String?   @map("first_name") @db.VarChar(64)
  lastName    String?   @map("last_name") @db.VarChar(64)
  birthDate   DateTime? @map("birth_date") @db.Date
  licence     String?   @unique @db.VarChar(64)
  notes       String?   @db.VarChar(1024)
  teamId      String?   @map("team_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  participants Participant[]
  statistics   Statistic[]
  invitations  Invitation[]

  @@index([teamId])
  @@index([displayName])
  @@map("players")
}

/// Invitación de jugador por correo (G-D/F5, §3.1/§6.5). Genera un código; al
/// aceptarlo, el invitado pasa a ser un `Player` registrado (se guarda su histórico).
/// El envío real de correo depende de configurar SMTP; mientras, el código queda
/// registrado y visible para el admin (auditable, regenerable).
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @db.VarChar(255)
  displayName    String?   @map("display_name") @db.VarChar(128)
  code           String    @unique @db.VarChar(16)
  /// pending | accepted | revoked
  status         String    @default("pending") @db.VarChar(16)
  invitedBy      String?   @map("invited_by") @db.VarChar(64)
  playerId       String?   @map("player_id") @db.Uuid
  /// Resultado del último intento de envío (p. ej. "SMTP sin configurar").
  dispatchNote   String?   @map("dispatch_note") @db.VarChar(255)
  lastDispatchAt DateTime? @map("last_dispatch_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("invitations")
}

/// Configuración SMTP para el envío de correos (una sola fila). La contraseña se
/// guarda pero NUNCA se devuelve por la API. Mientras no esté configurada, las
/// invitaciones muestran el código en el panel.
model SmtpSetting {
  id          String   @id @default("singleton")
  host        String?  @db.VarChar(255)
  port        Int?
  secure      Boolean  @default(true)
  username    String?  @db.VarChar(255)
  password    String?  @db.VarChar(512)
  fromAddress String?  @map("from_address") @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("smtp_settings")
}

// ---------------------------------------------------------------------------
// 2. Instalación física: sistemas, módulos, posiciones, dianas, calibración
// ---------------------------------------------------------------------------

enum SystemState {
  idle
  configuring
  ready
  game_running
  degraded
  maintenance
}

model TargetSystem {
  id                  String      @id @default(uuid()) @db.Uuid
  /// Identificador de tópico MQTT: ^[a-z0-9][a-z0-9-]{2,62}$
  slug                String      @unique @db.VarChar(63)
  name                String      @db.VarChar(128)
  description         String?     @db.VarChar(512)
  state               SystemState @default(idle)
  coordinatorModuleId String?     @map("coordinator_module_id") @db.Uuid
  modulesExpected     Int         @default(0) @map("modules_expected")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  modules    Module[]
  positions  ModulePosition[]
  games      Game[]
  hitEvents  HitEvent[]
  incidents  Incident[]
  viewPanels ViewPanel[]

  @@map("target_systems")
}

enum ModuleRole {
  principal
  satellite
  auto
}

enum SelectorPosition {
  SATELITE
  AUTO
  PRINCIPAL
}

enum ModuleState {
  boot
  selftest
  network
  registering
  ready
  calibration
  maintenance
  game_prepare
  game_countdown
  game_active
  game_paused
  game_finished
  error
}

model Module {
  id               String            @id @default(uuid()) @db.Uuid
  /// Identificador de tópico MQTT del módulo.
  slug             String            @unique @db.VarChar(63)
  targetSystemId   String?           @map("target_system_id") @db.Uuid
  friendlyName     String?           @map("friendly_name") @db.VarChar(128)
  /// Dueño (gestor) del módulo. Se asigna al canjear un código de vinculación
  /// (docs/product/alcance-panel-roles-firmware.md §0.b). Un usuario con ≥1
  /// módulo vinculado ejerce de gestor. NULL = módulo libre / del admin.
  ownerId          String?           @map("owner_id") @db.Uuid
  serial           String?           @unique @db.VarChar(64)
  mac              String?           @db.VarChar(17)
  ip               String?           @db.VarChar(45)
  hardwareRevision String?           @map("hardware_revision") @db.VarChar(32)
  firmwareVersion  String?           @map("firmware_version") @db.VarChar(32)
  role             ModuleRole?
  selector         SelectorPosition?
  state            ModuleState?
  online           Boolean           @default(false)
  /// UUID de arranque vigente. Cambia en cada reinicio (ADR-0003).
  bootId           String?           @map("boot_id") @db.Uuid
  queueDepth       Int               @default(0) @map("queue_depth")
  configVersion    Int               @default(0) @map("config_version")
  lastSeenAt       DateTime?         @map("last_seen_at") @db.Timestamptz(6)
  maintenance      Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  targetSystem TargetSystem?   @relation(fields: [targetSystemId], references: [id], onDelete: SetNull)
  owner        User?           @relation("ModuleOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  position     ModulePosition?
  targets      Target[]
  hitEvents    HitEvent[]
  deployments  Deployment[]
  incidents    Incident[]

  @@index([targetSystemId])
  @@index([ownerId])
  @@index([online])
  @@map("modules")
}

/// Posición vigente del módulo dentro de la matriz 3x3 (dosier 6.1).
/// El histórico de cambios queda en `audit_log`.
model ModulePosition {
  id             String   @id @default(uuid()) @db.Uuid
  moduleId       String   @unique @map("module_id") @db.Uuid
  targetSystemId String   @map("target_system_id") @db.Uuid
  x              Int
  y              Int
  rotation       Int      @default(0)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy     String?  @map("assigned_by") @db.VarChar(64)

  module       Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  targetSystem TargetSystem @relation(fields: [targetSystemId], references: [id], onDelete: Cascade)

  @@unique([targetSystemId, x, y])
  @@index([targetSystemId])
  @@map("module_positions")
}

enum TargetState {
  off
  safe
  active
  hit
  countdown
  penalty
  error
  calibration
  locked
  sensor_error
  maintenance
  disabled
}

model Target {
  id          String      @id @default(uuid()) @db.Uuid
  moduleId    String      @map("module_id") @db.Uuid
  /// 1..9, orden de lectura dentro del módulo (dosier 6.2).
  targetIndex Int         @map("target_index") @db.SmallInt
  label       String?     @db.VarChar(64)
  enabled     Boolean     @default(true)
  state       TargetState @default(off)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  module       Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  calibrations SensorCalibration[]
  hitEvents    HitEvent[]

  @@unique([moduleId, targetIndex])
  @@index([moduleId])
  @@map("targets")
}

enum CalibrationSource {
  manual
  auto
  reported
  factory
}

model SensorCalibration {
  id             String            @id @default(uuid()) @db.Uuid
  targetId       String            @map("target_id") @db.Uuid
  threshold      Int
  hysteresis     Int
  noiseFloor     Int?              @map("noise_floor")
  blankingUs     Int               @map("blanking_us")
  groupWindowUs  Int               @map("group_window_us")
  neighbourRatio Float             @map("neighbour_ratio")
  enabled        Boolean           @default(true)
  configVersion  Int               @default(1) @map("config_version")
  source         CalibrationSource @default(manual)
  /// Valores INICIALES de prototipo: no constituyen calibración física validada.
  validated      Boolean           @default(false)
  calibratedAt   DateTime          @default(now()) @map("calibrated_at") @db.Timestamptz(6)
  calibratedBy   String?           @map("calibrated_by") @db.VarChar(64)

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, calibratedAt])
  @@map("sensor_calibrations")
}

// ---------------------------------------------------------------------------
// 3. Catálogo de juego
// ---------------------------------------------------------------------------

model GameMode {
  id           String   @id @default(uuid()) @db.Uuid
  /// Clave de la estrategia registrada en el motor: random, sequence,
  /// all_against_clock, reaction.
  key          String   @unique @db.VarChar(48)
  name         String   @db.VarChar(128)
  description  String?  @db.VarChar(1024)
  /// Esquema JSON de los parámetros aceptados por el modo.
  paramsSchema Json?    @map("params_schema")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  presets GamePreset[]
  games   Game[]

  @@map("game_modes")
}

model GamePreset {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  gameModeId  String   @map("game_mode_id") @db.Uuid
  config      Json
  isSample    Boolean  @default(false) @map("is_sample")
  /// Dueño (gestor) del preset. NULL = preset de muestra / del sistema (visible a
  /// todos). Cada gestor tiene los suyos, con un tope (G-F). El nombre es único por
  /// dueño, no global, para que dos gestores puedan usar el mismo nombre.
  ownerId     String?  @map("owner_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  gameMode GameMode @relation(fields: [gameModeId], references: [id], onDelete: Restrict)
  owner    User?    @relation("PresetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  games    Game[]

  @@unique([ownerId, name])
  @@index([gameModeId])
  @@index([ownerId])
  @@map("game_presets")
}

// ---------------------------------------------------------------------------
// 4. Partidas
// ---------------------------------------------------------------------------

enum GameStatus {
  draft
  armed
  running
  paused
  finished
  aborted
}

enum RoundPhase {
  armed
  countdown
  running
  paused
  finished
  aborted
}

model Game {
  id             String     @id @default(uuid()) @db.Uuid
  targetSystemId String     @map("target_system_id") @db.Uuid
  gameModeId     String     @map("game_mode_id") @db.Uuid
  gamePresetId   String?    @map("game_preset_id") @db.Uuid
  name           String?    @db.VarChar(128)
  /// Código corto para unirse a la partida por QR (G-D). Único; regenerable.
  joinCode       String?    @unique @map("join_code") @db.VarChar(16)
  /// Vista (grupo de paneles) sobre la que se juega, cuando la partida abarca
  /// varios paneles (G-H, Opción B). NULL = partida sobre un solo panel (`targetSystem`).
  viewId         String?    @map("view_id") @db.Uuid
  status         GameStatus @default(draft)
  /// Semilla del generador determinista (reproducibilidad, encargo 10).
  seed           BigInt?
  config         Json
  createdBy      String?    @map("created_by") @db.VarChar(64)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  armedAt        DateTime?  @map("armed_at") @db.Timestamptz(6)
  startedAt      DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz(6)

  targetSystem TargetSystem  @relation(fields: [targetSystemId], references: [id], onDelete: Restrict)
  gameMode     GameMode      @relation(fields: [gameModeId], references: [id], onDelete: Restrict)
  gamePreset   GamePreset?   @relation(fields: [gamePresetId], references: [id], onDelete: SetNull)
  view         View?         @relation(fields: [viewId], references: [id], onDelete: SetNull)
  rounds       Round[]
  participants Participant[]
  hitEvents    HitEvent[]
  statistics   Statistic[]

  @@index([targetSystemId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([viewId])
  @@map("games")
}

/// Vista: agrupa varios PANELES (`TargetSystem`) para jugar una partida sobre todos
/// a la vez (G-H, Opción B). Es el nivel por encima del panel; tope en este nivel.
/// El motor ya es agnóstico al panel, así que una vista sólo agrega los objetivos de
/// sus paneles y se los pasa al mismo motor.
model View {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(128)
  description String?  @db.VarChar(512)
  ownerId     String?  @map("owner_id") @db.Uuid
  createdBy   String?  @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner  User?       @relation("ViewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  panels ViewPanel[]
  games  Game[]

  @@index([ownerId])
  @@map("views")
}

/// Pertenencia de un panel a una vista, con orden. Un panel puede estar en varias
/// vistas; una vista ordena sus paneles por `position`.
model ViewPanel {
  id             String @id @default(uuid()) @db.Uuid
  viewId         String @map("view_id") @db.Uuid
  targetSystemId String @map("target_system_id") @db.Uuid
  position       Int    @default(0)

  view         View         @relation(fields: [viewId], references: [id], onDelete: Cascade)
  targetSystem TargetSystem @relation(fields: [targetSystemId], references: [id], onDelete: Cascade)

  @@unique([viewId, targetSystemId])
  @@index([viewId])
  @@map("view_panels")
}

model Round {
  id                 String     @id @default(uuid()) @db.Uuid
  gameId             String     @map("game_id") @db.Uuid
  roundIndex         Int        @map("round_index")
  phase              RoundPhase @default(armed)
  mode               String     @db.VarChar(48)
  seed               BigInt?
  /// Plan generado por la estrategia del modo (orden y activaciones).
  plan               Json?
  countdownMs        Int        @default(3000) @map("countdown_ms")
  timeLimitMs        Int?       @map("time_limit_ms")
  penaltyMs          Int        @default(0) @map("penalty_ms")
  strictOrder        Boolean    @default(false) @map("strict_order")
  reactionDelayMinMs Int?       @map("reaction_delay_min_ms")
  reactionDelayMaxMs Int?       @map("reaction_delay_max_ms")
  /// Duración consolidada por el COORDINADOR (T2), en microsegundos.
  durationUs         BigInt?    @map("duration_us")
  startedAt          DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?  @map("finished_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participants Participant[]
  hitEvents    HitEvent[]
  penalties    Penalty[]
  results      Result[]
  statistics   Statistic[]

  @@unique([gameId, roundIndex])
  @@index([gameId])
  @@map("rounds")
}

model Participant {
  id        String  @id @default(uuid()) @db.Uuid
  gameId    String  @map("game_id") @db.Uuid
  roundId   String? @map("round_id") @db.Uuid
  playerId  String? @map("player_id") @db.Uuid
  /// Nombre de un jugador TEMPORAL (§3.4): identidad por partida, sin `User` ni
  /// `Player`, sin estadística acumulada. Excluyente con `playerId`. Dos temporales
  /// con el mismo nombre en partidas distintas NO tienen relación.
  guestName String? @map("guest_name") @db.VarChar(128)
  teamId    String? @map("team_id") @db.Uuid
  slot      Int     @default(1)
  lane      String? @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round      Round?      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player     Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shotCounts ShotCount[]
  penalties  Penalty[]
  results    Result[]
  hitEvents  HitEvent[]

  @@unique([gameId, slot, roundId])
  @@index([playerId])
  @@index([gameId])
  @@map("participants")
}

// ---------------------------------------------------------------------------
// 5. Eventos de impacto (ADR-0002 y ADR-0003)
// ---------------------------------------------------------------------------

enum HitClassification {
  valid_hit
  hit_on_safe
  hit_on_already_hit
  out_of_order
  crosstalk_rejected
  ambiguous
  during_pause
  calibration_hit
  early_shot
}

/// Evento inmutable. El backend no reescribe jamás T1 (`device_*`) ni T2
/// (`coordinator_*`); si el evento llega fuera de ventana lo MARCA con
/// `out_of_window` y documenta el motivo (ADR-0002, dosier 20.3).
model HitEvent {
  id String @id @default(uuid()) @db.Uuid

  /// ADR-0003: identificador generado por el módulo detector. Único.
  eventId String @unique @map("event_id") @db.VarChar(64)

  targetSystemId String? @map("target_system_id") @db.Uuid
  systemSlug     String  @map("system_slug") @db.VarChar(63)
  moduleId       String? @map("module_id") @db.Uuid
  moduleSlug     String  @map("module_slug") @db.VarChar(63)
  targetId       String? @map("target_id") @db.Uuid
  targetIndex    Int     @map("target_index") @db.SmallInt

  gameId        String? @map("game_id") @db.Uuid
  roundId       String? @map("round_id") @db.Uuid
  participantId String? @map("participant_id") @db.Uuid

  modulePositionX Int?   @map("module_position_x") @db.SmallInt
  modulePositionY Int?   @map("module_position_y") @db.SmallInt
  moduleRotation  Int?   @map("module_rotation") @db.SmallInt
  localSequence   BigInt @map("local_sequence")

  // --- T1 · captura en el ESP32. Propiedad del firmware. Inmutable. ---
  deviceBootId   String  @map("device_boot_id") @db.Uuid
  deviceUptimeUs BigInt  @map("device_uptime_us")
  deviceEventUs  BigInt  @map("device_event_us")
  deviceEpochMs  BigInt? @map("device_epoch_ms")

  // --- T2 · consolidación del coordinador. Propiedad del principal. Inmutable. ---
  coordinatorRecvUs    BigInt? @map("coordinator_recv_us")
  coordinatorElapsedUs BigInt? @map("coordinator_elapsed_us")
  clockOffsetUs        BigInt? @map("clock_offset_us")
  offsetUncertaintyUs  BigInt? @map("offset_uncertainty_us")

  // --- T3 y T4 · propiedad del backend. Nunca viajan en el payload MQTT. ---
  receivedAt  DateTime @map("received_at") @db.Timestamptz(6)
  persistedAt DateTime @default(now()) @map("persisted_at") @db.Timestamptz(6)

  amplitude            Int
  threshold            Int
  noiseFloor           Int?              @map("noise_floor")
  neighbours           Json?
  targetStateBefore    TargetState       @map("target_state_before")
  classification       HitClassification
  classificationReason String?           @map("classification_reason") @db.VarChar(120)
  firmwareVersion      String            @map("firmware_version") @db.VarChar(32)
  /// Reenvío desde la cola local. NO implica duplicado (ADR-0003).
  replay               Boolean           @default(false)

  /// Marca del backend: el evento llegó fuera de la ventana admisible.
  /// Marcar != corregir. T1 y T2 permanecen intactos.
  outOfWindow       Boolean @default(false) @map("out_of_window")
  outOfWindowReason String? @map("out_of_window_reason") @db.VarChar(255)
  /// Deriva de la clasificación: sólo `valid_hit` puntúa.
  countsForScore    Boolean @default(false) @map("counts_for_score")

  /// Payload MQTT crudo tal cual llegó, para auditoría forense.
  rawPayload Json @map("raw_payload")

  targetSystem TargetSystem? @relation(fields: [targetSystemId], references: [id], onDelete: SetNull)
  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  target       Target?       @relation(fields: [targetId], references: [id], onDelete: SetNull)
  game         Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  round        Round?        @relation(fields: [roundId], references: [id], onDelete: SetNull)
  participant  Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  penalties    Penalty[]

  /// ADR-0003: la tupla identifica de forma única el evento aunque se pierda
  /// el `event_id` (p. ej. tras un reflasheo que reinicia `local_sequence`).
  @@unique([moduleSlug, deviceBootId, localSequence], name: "hit_module_boot_sequence")
  @@index([roundId, deviceEventUs])
  @@index([gameId, classification])
  @@index([participantId])
  @@index([moduleSlug, receivedAt])
  @@index([receivedAt])
  @@map("hit_events")
}

// ---------------------------------------------------------------------------
// 6. Munición, penalizaciones, resultados y estadísticas (ADR-0006)
// ---------------------------------------------------------------------------

enum ShotCountSource {
  /// El operador introduce la munición restante contada a mano.
  manual
  /// Contador automático externo (barrera óptica, sensor de gatillo…).
  auto_counter
  /// La partida exigía consumir toda la munición.
  full_magazine
}

/// Registro de munición de un participante. Distingue explícitamente los
/// conceptos del dosier 17.2. `remainingKnown = false` ⇒ disparos y precisiones
/// son NULL y la API responde `not_computable` (ADR-0006).
model ShotCount {
  id             String          @id @default(uuid()) @db.Uuid
  participantId  String          @map("participant_id") @db.Uuid
  source         ShotCountSource @default(manual)
  initialAmmo    Int             @map("initial_ammo")
  remainingAmmo  Int?            @map("remaining_ammo")
  remainingKnown Boolean         @default(false) @map("remaining_known")
  mustUseAllAmmo Boolean         @default(false) @map("must_use_all_ammo")
  /// Derivado y persistido sólo cuando es calculable. NUNCA se rellena
  /// sustituyendo lo desconocido por la munición inicial.
  shotsFired     Int?            @map("shots_fired")
  recordedAt     DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy     String?         @map("recorded_by") @db.VarChar(64)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, recordedAt])
  @@map("shot_counts")
}

enum PenaltyKind {
  wrong_target
  hit_on_safe
  hit_on_already_hit
  out_of_order
  early_shot
  during_pause
  manual
}

model Penalty {
  id            String      @id @default(uuid()) @db.Uuid
  roundId       String      @map("round_id") @db.Uuid
  participantId String?     @map("participant_id") @db.Uuid
  hitEventId    String?     @map("hit_event_id") @db.Uuid
  kind          PenaltyKind
  penaltyMs     Int         @map("penalty_ms")
  reason        String?     @db.VarChar(255)
  appliedBy     String?     @map("applied_by") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  round       Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  hitEvent    HitEvent?    @relation(fields: [hitEventId], references: [id], onDelete: SetNull)

  @@unique([hitEventId])
  @@index([roundId])
  @@index([participantId])
  @@map("penalties")
}

enum AccuracyStatus {
  computed
  not_computable
}

/// Resultado derivado y reproducible de una ronda para un participante.
model Result {
  id            String @id @default(uuid()) @db.Uuid
  roundId       String @map("round_id") @db.Uuid
  participantId String @map("participant_id") @db.Uuid

  position       Int?
  score          Int     @default(0)
  /// Tiempo consolidado por el coordinador (T2), microsegundos.
  totalTimeUs    BigInt? @map("total_time_us")
  firstHitUs     BigInt? @map("first_hit_us")
  detectedHits   Int     @default(0) @map("detected_hits")
  validHits      Int     @default(0) @map("valid_hits")
  invalidHits    Int     @default(0) @map("invalid_hits")
  penaltiesCount Int     @default(0) @map("penalties_count")
  penaltiesMs    Int     @default(0) @map("penalties_ms")

  initialAmmo    Int?           @map("initial_ammo")
  remainingAmmo  Int?           @map("remaining_ammo")
  /// NULL cuando la munición restante es desconocida (ADR-0006).
  shotsFired     Int?           @map("shots_fired")
  accuracyTotal  Float?         @map("accuracy_total")
  accuracyValid  Float?         @map("accuracy_valid")
  accuracyStatus AccuracyStatus @default(not_computable) @map("accuracy_status")
  accuracyReason String?        @map("accuracy_reason") @db.VarChar(255)

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
  @@index([participantId, computedAt])
  @@map("results")
}

enum StatisticScope {
  player
  team
  game
  round
  global
}

model Statistic {
  id          String         @id @default(uuid()) @db.Uuid
  scope       StatisticScope
  metric      String         @db.VarChar(64)
  playerId    String?        @map("player_id") @db.Uuid
  gameId      String?        @map("game_id") @db.Uuid
  roundId     String?        @map("round_id") @db.Uuid
  value       Float?
  valueJson   Json?          @map("value_json")
  periodStart DateTime?      @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime?      @map("period_end") @db.Timestamptz(6)
  computedAt  DateTime       @default(now()) @map("computed_at") @db.Timestamptz(6)

  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round  Round?  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([scope, metric, playerId, gameId, roundId, periodStart])
  @@index([playerId, metric])
  @@index([computedAt])
  @@map("statistics")
}

// ---------------------------------------------------------------------------
// 7. Firmware, despliegues, incidencias y auditoría
// ---------------------------------------------------------------------------

model FirmwareVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @db.VarChar(32)
  targetBoard String   @map("target_board") @db.VarChar(64)
  url         String   @db.VarChar(512)
  sha256      String   @db.Char(64)
  sizeBytes   Int      @map("size_bytes")
  /// OTA firmada obligatoria (dosier 23.3). Sin firma no se despliega.
  signature   String?  @db.VarChar(1024)
  signed      Boolean  @default(false)
  notes       String?  @db.VarChar(1024)
  releasedAt  DateTime @default(now()) @map("released_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.VarChar(64)

  deployments Deployment[]

  @@unique([version, targetBoard])
  @@map("firmware_versions")
}

enum DeploymentStatus {
  pending
  sent
  downloading
  installing
  success
  failed
  rolled_back
}

model Deployment {
  id                String           @id @default(uuid()) @db.Uuid
  firmwareVersionId String           @map("firmware_version_id") @db.Uuid
  moduleId          String           @map("module_id") @db.Uuid
  status            DeploymentStatus @default(pending)
  commandId         String?          @map("command_id") @db.Uuid
  previousVersion   String?          @map("previous_version") @db.VarChar(32)
  error             String?          @db.VarChar(512)
  requestedBy       String?          @map("requested_by") @db.VarChar(64)
  startedAt         DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?        @map("finished_at") @db.Timestamptz(6)

  firmwareVersion FirmwareVersion @relation(fields: [firmwareVersionId], references: [id], onDelete: Restrict)
  module          Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, startedAt])
  @@index([status])
  @@map("deployments")
}

enum IncidentSeverity {
  info
  warning
  error
  critical
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  kind           String           @db.VarChar(64)
  severity       IncidentSeverity @default(warning)
  source         String           @db.VarChar(64)
  moduleId       String?          @map("module_id") @db.Uuid
  targetSystemId String?          @map("target_system_id") @db.Uuid
  eventId        String?          @map("event_id") @db.VarChar(64)
  message        String           @db.VarChar(1024)
  detail         Json?
  occurredAt     DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?          @map("resolved_by") @db.VarChar(64)

  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  targetSystem TargetSystem? @relation(fields: [targetSystemId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([severity, occurredAt])
  @@index([moduleId, occurredAt])
  @@map("incidents")
}

/// Auditoría de acciones administrativas (dosier 21.2 y 23.2).
/// Nunca contiene credenciales: el servicio de auditoría redacta los campos
/// sensibles antes de escribir.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorUsername String?  @map("actor_username") @db.VarChar(64)
  actorRole     String?  @map("actor_role") @db.VarChar(32)
  action        String   @db.VarChar(64)
  entity        String   @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

/// Matriz favorita (G-H): instantánea con nombre de la colocación de módulos de
/// un panel. Se guarda por SLUG de módulo, no por id, para poder aplicarla a un
/// panel distinto o tras sustituir hardware.
model MatrixLayout {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(128)
  description    String?  @db.VarChar(512)
  ownerId        String?  @map("owner_id") @db.Uuid
  /// Panel del que se capturó (informativo; la matriz es aplicable a cualquiera).
  originSystemId String?  @map("origin_system_id") @db.Uuid
  /// [{ slug, x, y, rotation }]
  cells          Json
  favorite       Boolean  @default(false)
  createdBy      String?  @map("created_by") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User? @relation("LayoutOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("matrix_layouts")
}
