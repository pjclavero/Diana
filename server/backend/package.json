{
  "name": "@diana/backend",
  "version": "0.1.0",
  "description": "Backend Diana - API REST, ingesta MQTT y motor de partidas",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "test:cov": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed:reference": "ts-node -T src/scripts/seed-reference.ts",
    "seed:dev": "ts-node -T src/scripts/seed-dev.ts",
    "openapi": "ts-node -T src/scripts/export-openapi.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.6",
    "@prisma/client": "6.14.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "mqtt": "5.14.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@nestjs/testing": "11.1.6",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "js-yaml": "^4.1.0",
    "prisma": "6.14.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
