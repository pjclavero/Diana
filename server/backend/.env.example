# Ejemplo de entorno del BACKEND de Diana (WP-02).
# Copiar a .env y rellenar. NUNCA subir el .env real al repositorio.
# El .env.example de la raíz lo gestiona WP-01 (infraestructura); este fichero
# documenta sólo las variables que consume este servicio.

# --- Base de datos -----------------------------------------------------------
DATABASE_URL=postgresql://diana:CAMBIAR@postgres:5432/diana?schema=public

# --- API ---------------------------------------------------------------------
PORT=3000
API_PREFIX=api
# Lista separada por comas. Vacío = CORS deshabilitado (recomendado tras proxy).
CORS_ORIGINS=

# --- Sesiones ----------------------------------------------------------------
# OBLIGATORIO en producción: sin él el arranque falla a propósito.
# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Cuenta inicial ----------------------------------------------------------
# Se crea SÓLO si no hay ningún usuario en la base de datos, y siempre con
# "cambio obligatorio en el primer acceso". Si DIANA_ADMIN_PASSWORD se deja
# vacío, el backend genera una credencial aleatoria y la escribe UNA vez en el
# log de arranque. No hay contraseñas por defecto en el código.
DIANA_ADMIN_USERNAME=admin
DIANA_ADMIN_PASSWORD=
DIANA_ADMIN_EMAIL=

# --- MQTT --------------------------------------------------------------------
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=CAMBIAR
MQTT_CLIENT_ID=diana-backend
MQTT_ENABLED=true
# Plazo máximo de espera del PUBACK del broker, en ms. mqtt.js no impone
# ninguno; el arranque de partida espera esa confirmación con el cerrojo del
# panel tomado, así que sin plazo un broker mudo bloquearía el panel.
MQTT_PUBLISH_ACK_TIMEOUT_MS=5000

# --- Ingesta -----------------------------------------------------------------
# Retraso máximo, en ms, entre la recepción (T3) y la persistencia (T4) antes
# de MARCAR el evento como fuera de ventana. Marcar no es corregir: T1 y T2
# nunca se tocan (ADR-0002).
INGEST_MAX_PERSIST_LATENCY_MS=5000

# --- Retención (la aplica el worker) -----------------------------------------
RETENTION_HIT_EVENTS_DAYS=730
RETENTION_TELEMETRY_DAYS=30
RETENTION_AUDIT_DAYS=1095

# --- Sólo para herramientas ---------------------------------------------------
# DIANA_CONTRACTS_DIR=/app/contracts
# DIANA_SKIP_DB=1          # instanciar la app sin PostgreSQL (generar OpenAPI)
# DIANA_SKIP_BOOTSTRAP=1   # no crear la cuenta inicial
