{
  "name": "@diana/worker",
  "version": "0.1.0",
  "description": "Proceso de tareas diferidas de Diana: estadísticas, exportaciones y retención",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -T src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate --schema ../backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.14.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.9",
    "jest": "29.7.0",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "prisma": "6.14.0"
  }
}
